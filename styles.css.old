/**
 * BookShelf - Complete Enhanced Premium Styles
 * Version 4.0 - Modern UI with Enhanced E-Reader
 */

/* ============================================================================
   IMPORTS & FONTS
   ============================================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

/* ============================================================================
   CSS VARIABLES
   ============================================================================ */

:root {
    /* Light Mode Colors */
    --bg-primary: #ffffff;
    --bg-secondary: #f8fafc;
    --bg-tertiary: #f1f5f9;
    
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --text-tertiary: #94a3b8;
    
    --border-color: #e2e8f0;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    
    /* Accent Colors */
    --primary-50: #faf5ff;
    --primary-500: #a855f7;
    --primary-600: #9333ea;
    --primary-700: #7e22ce;
}

.dark {
    /* Dark Mode Colors */
    --bg-primary: #0f172a;
    --bg-secondary: #1e293b;
    --bg-tertiary: #334155;
    
    --text-primary: #f1f5f9;
    --text-secondary: #cbd5e1;
    --text-tertiary: #94a3b8;
    
    --border-color: #334155;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.4);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 10px 10px -5px rgba(0, 0, 0, 0.5);
    
    /* Adjusted for better dark mode */
    --primary-400: #c084fc;
    --primary-500: #a855f7;
    --primary-600: #9333ea;
}

/* ============================================================================
   GLOBAL STYLES
   ============================================================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg-secondary);
    color: var(--text-primary);
    transition: background-color 0.3s ease, color 0.3s ease;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ============================================================================
   BOOK CARDS - Enhanced Design
   ============================================================================ */

.book-card {
    background: var(--bg-primary);
    border-radius: 1rem;
    padding: 0.875rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
}

.book-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--primary-500), var(--primary-600));
    transform: scaleX(0);
    transition: transform 0.3s ease;
}

.book-card:hover::before {
    transform: scaleX(1);
}

.book-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
    border-color: var(--primary-500);
}

/* ============================================================================
   BOOK COVERS - Premium Look
   ============================================================================ */

.book-cover-wrapper {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
}

.book-cover {
    width: 100%;
    padding-top: 150%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-md);
}

.book-cover-loading {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.book-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0));
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.book-card:hover .book-overlay {
    opacity: 1;
}

.book-card:hover .book-cover {
    transform: scale(1.05);
    box-shadow: var(--shadow-lg);
}

/* ============================================================================
   TEXT UTILITIES
   ============================================================================ */

.line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
}

.line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
}

/* ============================================================================
   EPUB READER - Modernized
   ============================================================================ */

#reader {
    backdrop-filter: blur(10px);
}

#epub-viewer {
    background: var(--bg-primary);
    color: var(--text-primary);
    position: relative;
}

#epub-viewer iframe {
    border: none;
    width: 100%;
    height: 100%;
}

/* ============================================================================
   READER CONTROL BUTTONS
   ============================================================================ */

.reader-btn {
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    box-shadow: var(--shadow-md);
    white-space: nowrap;
}

.reader-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.reader-btn:active {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
}

.reader-btn-primary {
    background: linear-gradient(135deg, var(--primary-600), var(--primary-700));
    color: white;
}

.reader-btn-primary:hover {
    background: linear-gradient(135deg, var(--primary-700), var(--primary-600));
}

.dark .reader-btn-primary {
    background: linear-gradient(135deg, var(--primary-500), var(--primary-600));
}

.reader-btn-secondary {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
}

.reader-btn-secondary:hover {
    background: var(--bg-primary);
    border-color: var(--primary-500);
}

.reader-btn-danger {
    background: linear-gradient(135deg, #dc2626, #b91c1c);
    color: white;
}

.reader-btn-danger:hover {
    background: linear-gradient(135deg, #b91c1c, #991b1b);
}

/* ============================================================================
   READER PANELS - TOC & SETTINGS
   ============================================================================ */

#toc-panel,
#settings-panel {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
}

#toc-panel.hidden {
    transform: translateX(-100%);
    pointer-events: none;
}

#settings-panel.hidden {
    transform: translateX(100%);
    pointer-events: none;
}

#toc-panel:not(.hidden),
#settings-panel:not(.hidden) {
    transform: translateX(0);
    pointer-events: auto;
}

/* Panel Scrollbar Styling */
#toc-panel::-webkit-scrollbar,
#settings-panel::-webkit-scrollbar {
    width: 8px;
}

#toc-panel::-webkit-scrollbar-track,
#settings-panel::-webkit-scrollbar-track {
    background: var(--bg-secondary);
}

#toc-panel::-webkit-scrollbar-thumb,
#settings-panel::-webkit-scrollbar-thumb {
    background: var(--primary-500);
    border-radius: 4px;
}

#toc-panel::-webkit-scrollbar-thumb:hover,
#settings-panel::-webkit-scrollbar-thumb:hover {
    background: var(--primary-600);
}

/* ============================================================================
   TABLE OF CONTENTS STYLES
   ============================================================================ */

.toc-item {
    list-style: none;
    margin-bottom: 0.125rem;
}

.toc-link {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.75rem 1rem;
    color: var(--text-primary);
    background: transparent;
    border: none;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
}

.toc-link:hover {
    background: var(--bg-tertiary);
    color: var(--primary-600);
    padding-left: 1.25rem;
}

.dark .toc-link:hover {
    color: var(--primary-400);
}

.toc-subitem {
    list-style: none;
    margin-bottom: 0.125rem;
}

.toc-subitem .toc-link {
    padding-left: 2rem;
    font-size: 0.813rem;
    color: var(--text-secondary);
}

.toc-subitem .toc-link:hover {
    padding-left: 2.25rem;
}

/* Empty state for TOC */
#toc-list:empty::before {
    content: "Loading table of contents...";
    display: block;
    padding: 1rem;
    text-align: center;
    color: var(--text-tertiary);
    font-size: 0.875rem;
}

/* ============================================================================
   BOOKMARK STYLES
   ============================================================================ */

.bookmark-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem;
    border-radius: 0.5rem;
    background: var(--bg-secondary);
    transition: all 0.2s ease;
    border: 1px solid transparent;
}

.bookmark-item:hover {
    background: var(--bg-tertiary);
    border-color: var(--border-color);
    transform: translateX(4px);
}

.bookmark-link {
    flex: 1;
    text-align: left;
    min-width: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}

.bookmark-chapter {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-bottom: 0.125rem;
}

.bookmark-time {
    display: block;
    font-size: 0.75rem;
    color: var(--text-tertiary);
}

.bookmark-delete {
    padding: 0.375rem;
    color: var(--text-tertiary);
    background: transparent;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.bookmark-delete:hover {
    background: #fee2e2;
    color: #dc2626;
}

.dark .bookmark-delete:hover {
    background: rgba(127, 29, 29, 0.3);
    color: #fca5a5;
}

/* Empty state for bookmarks */
#bookmarks-list:empty::before {
    content: "No bookmarks yet. Press 'B' to add one.";
    display: block;
    padding: 1rem;
    text-align: center;
    color: var(--text-tertiary);
    font-size: 0.875rem;
}

/* ============================================================================
   READING PROGRESS
   ============================================================================ */

#reading-progress {
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 8px rgba(168, 85, 247, 0.4);
}

.dark #reading-progress {
    box-shadow: 0 0 8px rgba(192, 132, 252, 0.3);
}

#chapter-info {
    font-weight: 500;
    letter-spacing: -0.01em;
}

#progress-text {
    font-variant-numeric: tabular-nums;
}

/* ============================================================================
   SETTINGS PANEL INPUTS
   ============================================================================ */

#settings-panel select {
    cursor: pointer;
    transition: all 0.2s ease;
}

#settings-panel select:hover {
    border-color: var(--primary-500);
}

#settings-panel button {
    transition: all 0.2s ease;
}

#settings-panel button:active {
    transform: scale(0.95);
}

/* ============================================================================
   KEYBOARD SHORTCUT BADGES
   ============================================================================ */

kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-weight: 600;
    font-size: 0.75rem;
}

/* ============================================================================
   READER HEADER ENHANCEMENTS
   ============================================================================ */

#reader > div:first-child,
#reader-controls {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}

#reader button[title] {
    position: relative;
}

#reader button:not(.reader-btn):hover {
    transform: scale(1.05);
}

#reader button:not(.reader-btn):active {
    transform: scale(0.95);
}

/* ============================================================================
   AUTOCOMPLETE
   ============================================================================ */

#autocomplete-suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-height: 320px;
    overflow-y: auto;
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    border-top: none;
    border-radius: 0 0 0.75rem 0.75rem;
    box-shadow: var(--shadow-xl);
    z-index: 50;
    display: none;
    margin-top: 0.25rem;
}

#autocomplete-suggestions li {
    padding: 0.875rem 1rem;
    cursor: pointer;
    transition: all 0.15s ease;
    list-style: none;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.875rem;
}

#autocomplete-suggestions li:last-child {
    border-bottom: none;
}

#autocomplete-suggestions li:hover {
    background: var(--bg-tertiary);
    padding-left: 1.25rem;
}

/* Custom Scrollbar */
#autocomplete-suggestions::-webkit-scrollbar {
    width: 8px;
}

#autocomplete-suggestions::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: 0 0 0.5rem 0;
}

#autocomplete-suggestions::-webkit-scrollbar-thumb {
    background: var(--primary-500);
    border-radius: 4px;
}

#autocomplete-suggestions::-webkit-scrollbar-thumb:hover {
    background: var(--primary-600);
}

/* ============================================================================
   ANIMATIONS
   ============================================================================ */

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.animate-spin {
    animation: spin 1s linear infinite;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.book-card {
    animation: fadeIn 0.3s ease-out backwards;
}

.book-card:nth-child(1) { animation-delay: 0.05s; }
.book-card:nth-child(2) { animation-delay: 0.1s; }
.book-card:nth-child(3) { animation-delay: 0.15s; }
.book-card:nth-child(4) { animation-delay: 0.2s; }
.book-card:nth-child(5) { animation-delay: 0.25s; }
.book-card:nth-child(6) { animation-delay: 0.3s; }

@keyframes loading {
    0% {
        background-position: 200% 0;
    }
    100% {
        background-position: -200% 0;
    }
}

.skeleton {
    background: linear-gradient(
        90deg,
        var(--bg-tertiary) 25%,
        var(--bg-secondary) 50%,
        var(--bg-tertiary) 75%
    );
    background-size: 200% 100%;
    animation: loading 1.5s ease-in-out infinite;
}

/* ============================================================================
   RESPONSIVE DESIGN
   ============================================================================ */

@media (max-width: 768px) {
    #toc-panel,
    #settings-panel {
        width: 100%;
        max-width: 320px;
    }
    
    .reader-btn {
        padding: 0.625rem 1rem;
        font-size: 0.813rem;
    }
    
    .reader-btn span {
        display: none;
    }
    
    .reader-btn svg {
        margin: 0;
    }
}

@media (max-width: 640px) {
    .book-card {
        padding: 0.625rem;
    }
    
    .reader-btn {
        flex: 1 0 auto;
        min-width: 90px;
        justify-content: center;
        font-size: 0.813rem;
        padding: 0.625rem 1rem;
    }

    #reader-controls {
        gap: 0.5rem;
        padding: 0.75rem;
    }
    
    .book-cover {
        border-radius: 0.5rem;
    }
}

@media (max-width: 480px) {
    .book-cover {
        padding-top: 160%;
    }
    
    .book-card:hover {
        transform: translateY(-4px);
    }
    
    #chapter-info {
        font-size: 0.813rem;
    }
    
    .bookmark-chapter {
        font-size: 0.813rem;
    }
    
    .toc-link {
        font-size: 0.813rem;
        padding: 0.625rem 0.75rem;
    }
    
    .toc-subitem .toc-link {
        padding-left: 1.5rem;
        font-size: 0.75rem;
    }
}

/* ============================================================================
   FULLSCREEN MODE
   ============================================================================ */

#reader:fullscreen {
    background: var(--bg-primary);
}

#reader:fullscreen #reader-controls {
    opacity: 0;
    transform: translateY(100%);
    transition: all 0.3s ease;
}

#reader:fullscreen:hover #reader-controls {
    opacity: 1;
    transform: translateY(0);
}

/* ============================================================================
   ACCESSIBILITY
   ============================================================================ */

*:focus {
    outline: none;
}

*:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
    border-radius: 0.25rem;
}

#toc-panel button:focus-visible,
#settings-panel button:focus-visible,
#settings-panel select:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}

/* ============================================================================
   SMOOTH SCROLLING
   ============================================================================ */

html {
    scroll-behavior: smooth;
}

/* ============================================================================
   CUSTOM SELECTION
   ============================================================================ */

::selection {
    background-color: var(--primary-500);
    color: white;
}

::-moz-selection {
    background-color: var(--primary-500);
    color: white;
}

#epub-viewer ::selection {
    background-color: var(--primary-500);
    color: white;
}

#epub-viewer ::-moz-selection {
    background-color: var(--primary-500);
    color: white;
}

/* ============================================================================
   IMPROVED FORM ELEMENTS
   ============================================================================ */

input[type="text"],
select {
    transition: all 0.2s ease;
}

input[type="text"]:focus,
select:focus {
    transform: translateY(-1px);
    box-shadow: var(--shadow-lg);
}

/* ============================================================================
   PRINT STYLES
   ============================================================================ */

@media print {
    #reader,
    header,
    #reader-controls,
    .book-overlay {
        display: none !important;
    }
    
    #reader > *:not(#epub-viewer) {
        display: none !important;
    }
    
    #epub-viewer {
        position: static !important;
        width: 100% !important;
        height: auto !important;
    }
    
    .book-card {
        break-inside: avoid;
        page-break-inside: avoid;
    }
    
    body {
        background: white;
        color: black;
    }
}

/* ============================================================================
   UTILITY CLASSES
   ============================================================================ */

.backdrop-blur {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}

.glass-effect {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

.dark .glass-effect {
    background: rgba(15, 23, 42, 0.7);
}

/* ============================================================================
   GRADIENT TEXT
   ============================================================================ */

.gradient-text {
    background: linear-gradient(135deg, var(--primary-600), var(--primary-700));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.dark .gradient-text {
    background: linear-gradient(135deg, var(--primary-400), var(--primary-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}